
# Server Port
PORT=8282

# Environment (development or production)
NODE_ENV=production

# Security (Required for authentication)
# Generate a secure random string for this value
JWT_SECRET=change_this_to_a_secure_random_string

# Data Storage
DATA_DIR=./data

# CORS (Optional: restrict access to specific domains)
# CORS_ORIGIN=http://localhost:5173

# Logging
# LOG_LEVEL=info          # debug | info | warn | error
# LOG_DIR=./data/logs
# LOG_MAX_BYTES=5242880
# LOG_MAX_FILES=5

# Upstream connections
# TAUTULLI_TIMEOUT_MS=20000
# PLEX_TIMEOUT_MS=8000
# ALLOW_INSECURE_TLS=false  # accept self-signed HTTPS certificates
